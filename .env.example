PY_AUTORELOAD=True
DJANGO_SECRET_KEY=django-super-secret
DJANGO_SETTINGS_MODULE=settings.docker

POSTGRES_PASSWORD=123
POSTGRES_DB=movies_rating

NGINX_PORT=8000
NGINX_SSL_PORT=8443
NGINX_CONFIG=./config/nginx.conf

# TMDB API Read Access Token (https://www.themoviedb.org/settings/api)
TMDB_API_TOKEN=

# Base URL for links in emails
SITE_URL=http://localhost:8000

# SMTP for emails. Leave EMAIL_HOST empty to print emails to `docker compose logs web`
EMAIL_HOST=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
